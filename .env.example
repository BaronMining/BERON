# AI provider: ollama or openai
BERON_AI_PROVIDER=ollama

# Ollama
BERON_OLLAMA_URL=http://localhost:11434
BERON_OLLAMA_MODEL=llama3.2

# OpenAI-compatible provider (optional)
BERON_OPENAI_API_KEY=
BERON_OPENAI_MODEL=

# Voice
BERON_WAKE_WORD=beron
BERON_LANGUAGE=en-US

# Database
BERON_DB_PATH=data/beron.db

# Security
BERON_REQUIRE_CONFIRMATION=true
